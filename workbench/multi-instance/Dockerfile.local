FROM debian:bookworm-slim
RUN apt-get update -o Acquire::Retries=5 && apt-get install -y -o Acquire::Retries=5 --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 rume \
    && useradd --system --uid 10001 --gid rume --home /app --shell /usr/sbin/nologin rume

WORKDIR /app
COPY target/release/workbench /app/workbench
COPY workbench/multi-instance/config /app/config
COPY workbench/multi-instance/migrations /app/migrations
COPY workbench/multi-instance/sql /app/sql
RUN chown -R rume:rume /app

USER rume

ENV HOST=0.0.0.0
ENV PORT=8080
ENV RUST_LOG=info
EXPOSE 8080

ENTRYPOINT ["/app/workbench"]
